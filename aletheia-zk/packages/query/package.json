{
  "name": "@aletheia/query",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed read client for Aletheia's on-chain records. Reads the Arkiv mirror of the contracts' events (replacing the original GraphQL subgraph client); every read carries how far the mirror has synced, so lag is answerable rather than invisible.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "check": "node --experimental-strip-types --no-warnings scripts/check.ts",
    "states": "node --experimental-strip-types --no-warnings scripts/states.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "viem": "^2.21.0"
  }
}
